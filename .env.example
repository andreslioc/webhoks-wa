# Puerto del servidor
PORT=3000

# --- WhatsApp Cloud API (Meta) ---
# Token que tu eliges y que escribes igual en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=mi_token_secreto
# App Secret de la app de Meta (opcional pero recomendado: valida la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Access token de la app (necesario solo para reenviar imagenes/audio/documentos)
WHATSAPP_TOKEN=

# --- Telegram ---
# Token que te dio @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAA...
# Chat/grupo/canal donde el bot publicara los mensajes
TELEGRAM_CHAT_ID=-1001234567890
# Opcional: id del hilo (topic) si el chat es un grupo con temas
TELEGRAM_THREAD_ID=

# Reenviar tambien los acuses (sent/delivered/read/failed). Por defecto no.
FORWARD_STATUSES=false

# --- Webhook generico /notify (el que llamas desde tu plataforma) ---
# Secreto opcional: si lo pones, la llamada debe incluirlo
# (cabecera x-webhook-secret, Authorization: Bearer, o ?token=)
NOTIFY_SECRET=
# Titulo por defecto del aviso
NOTIFY_TITLE="Aviso para asesor"
# Zona horaria de la hora que aparece en el aviso.
# Se llama NOTIFY_TZ porque Vercel reserva TZ y no deja definirla.
NOTIFY_TZ=America/Mexico_City

# Publicar tambien los campos que no se reconocen (por defecto si).
# Ponlo en false si tu plataforma manda mucho plumbing y solo quieres
# los campos con etiqueta (Nombre, Telefono, Mensaje...).
NOTIFY_EXTRAS=true

# --- Respuestas de Gemini para el Workflow de Zernio (/gemini) ---
# API key creada en Google AI Studio
GEMINI_API_KEY=
# Secreto que Zernio envia por cabecera o como ?token=. Si queda vacio,
# /gemini reutiliza NOTIFY_SECRET.
GEMINI_WEBHOOK_SECRET=
# Modelo y comportamiento del asesor
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=500
GEMINI_SYSTEM_PROMPT="Responde como asesor de Drop Shop, de forma breve y clara."

# --- Enlace para contestar (boton en el aviso) ---
# Si tu plataforma manda la URL del chat armada (campo link/url/chat_url/permalink),
# se usa esa y no hace falta nada mas aca.
# Si solo manda un id de conversacion, pon la plantilla con {id}:
#   CHAT_URL_TEMPLATE=https://app.tuplataforma.com/conversations/{id}
CHAT_URL_TEMPLATE=
# Texto del boton
CHAT_BUTTON_TEXT=💬 Contestar
